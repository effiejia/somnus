{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!.next", "!out", "!build", "!next-env.d.ts"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"rules": {
			"a11y": {
				"useButtonType": "off",
				"useKeyWithClickEvents": "info",
				"noSvgWithoutTitle": "info",
				"noStaticElementInteractions": "info"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/globals.css"],
			"formatter": { "enabled": false }
		}
	]
}
